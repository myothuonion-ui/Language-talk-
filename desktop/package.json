{
  "name": "language-talk-desktop",
  "productName": "Language Talk",
  "version": "0.2.0",
  "description": "Language Talk for Windows — Korean books, speaking practice and voice replays with Myanmar explanations",
  "author": "Myo Min Thu",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/smoke.cjs && node test/study-desk.cjs",
    "build:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.2.8",
    "@fontsource/noto-sans-myanmar": "5.2.7",
    "pdfjs-dist": "6.4.299",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.myothuonion.languagetalk.desktop",
    "productName": "Language Talk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "assets/**/*",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/src/main/assets/books",
        "to": "books"
      },
      {
        "from": "../app/src/main/assets/learning",
        "to": "learning"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Language-Talk-Setup-${version}-x64.exe"
    },
    "portable": {
      "artifactName": "Language-Talk-Portable-${version}-x64.exe"
    }
  }
}
